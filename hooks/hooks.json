{
  "description": "Blocks direct writes to resale records; resale_store.py is their only writer",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/guard_resale_items.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
